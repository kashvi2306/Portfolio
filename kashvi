export const staggerOnScroll = (targets, options = {}) => {
  gsap.from(targets, {
    scrollTrigger: {
      trigger: targets[0], // trigger when first element enters
      start: "top 80%",
      toggleActions: "play none none none",
    },
    opacity: 0,
    y: 50,
    duration: 1.2,
    ease: "power3.out",
    stagger: 0.2, // delay between each item
    ...options,
  });
};

