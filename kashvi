import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

// Parallax effect for multiple layers
export const parallaxScroll = (target, speed = 0.5) => {
  gsap.to(target, {
    yPercent: speed * 100,
    ease: "none",
    scrollTrigger: {
      trigger: target,
      start: "top bottom", // starts when section enters
      scrub: true,         // smooth continuous scroll
    },
  });
};


